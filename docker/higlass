#!/usr/bin/env bash
set -euo pipefail

APP_VERSION="2.3.5"
HOST_PORT="${HIGLASS_HOST_PORT:-8888}"
STARTUP_TIMEOUT="${HIGLASS_STARTUP_TIMEOUT:-120}"
WORKERS="${WORKERS:-1}"

if [ "$(id -u)" -eq 0 ]; then
  PORT="${HIGLASS_PORT:-80}"
  BIND_ADDRESS="${HIGLASS_BIND_ADDRESS:-0.0.0.0}"
else
  PORT="${HIGLASS_PORT:-8000}"
  BIND_ADDRESS="${HIGLASS_BIND_ADDRESS:-127.0.0.1}"
fi

LOG_FILE="${HIGLASS_LOG_FILE:-}"

print_help() {
  cat <<'EOF'
Usage: higlass [OPTIONS]

Start the packaged HiGlass browser service.

Options:
  --host-port PORT      Host port shown in the printed URL (default: 8888)
  --port PORT           Internal listen port (root: 80; non-root: 8000)
  --bind-address ADDR   Internal bind address (127.0.0.1 or 0.0.0.0)
  --startup-timeout N   Seconds to wait for service readiness (default: 120)
  --log-file FILE       Launcher log path (default: unique runtime /tmp)
  --version             Show packaged HiGlass component versions
  -h, --help            Show this help

Environment:
  HIGLASS_HOST_PORT, HIGLASS_PORT, HIGLASS_BIND_ADDRESS,
  HIGLASS_STARTUP_TIMEOUT, HIGLASS_LOG_FILE, WORKERS

Without a real writable bind at /data, the database and uploaded media are
ephemeral. The installed taf-higlass wrapper creates the backend-specific port
mapping and binds TAFFISH_HIGLASS_DATA_PATH to /data when that variable is set.
EOF
}

print_version() {
  echo "higlass ${APP_VERSION}"
  if [ -r /home/higlass/projects/higlass-app/version.txt ]; then
    cat /home/higlass/projects/higlass-app/version.txt
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host-port|--port|--bind-address|--startup-timeout|--log-file)
      option="$1"
      if [ "$#" -lt 2 ]; then
        printf >&2 'higlass: %s requires a value\n' "${option}"
        exit 2
      fi
      case "${option}" in
        --host-port) HOST_PORT="$2" ;;
        --port) PORT="$2" ;;
        --bind-address) BIND_ADDRESS="$2" ;;
        --startup-timeout) STARTUP_TIMEOUT="$2" ;;
        --log-file) LOG_FILE="$2" ;;
      esac
      shift 2
      ;;
    --host-port=*) HOST_PORT="${1#*=}"; shift ;;
    --port=*) PORT="${1#*=}"; shift ;;
    --bind-address=*) BIND_ADDRESS="${1#*=}"; shift ;;
    --startup-timeout=*) STARTUP_TIMEOUT="${1#*=}"; shift ;;
    --log-file=*) LOG_FILE="${1#*=}"; shift ;;
    --version) print_version; exit 0 ;;
    -h|--help) print_help; exit 0 ;;
    server|start) shift ;;
    --) shift ;;
    *)
      printf >&2 'higlass: unknown option or command: %s\n' "$1"
      echo "Run 'higlass --help' for usage." >&2
      exit 2
      ;;
  esac
done

for value_name in HOST_PORT PORT STARTUP_TIMEOUT WORKERS; do
  value="${!value_name}"
  if ! [[ "${value}" =~ ^[0-9]+$ ]]; then
    printf >&2 'higlass: %s must be a non-negative integer: %s\n' "${value_name}" "${value}"
    exit 2
  fi
done
if [ "${HOST_PORT}" -lt 1 ] || [ "${HOST_PORT}" -gt 65535 ] \
   || [ "${PORT}" -lt 1 ] || [ "${PORT}" -gt 65534 ] \
   || [ "${STARTUP_TIMEOUT}" -lt 1 ] || [ "${WORKERS}" -lt 1 ]; then
  echo "higlass: invalid port, timeout, or worker count." >&2
  exit 2
fi
case "${BIND_ADDRESS}" in
  127.0.0.1|0.0.0.0) ;;
  *)
    echo "higlass: --bind-address must be 127.0.0.1 or 0.0.0.0." >&2
    exit 2
    ;;
esac

runtime_root="$(mktemp -d /tmp/taf-higlass-runtime.XXXXXX)"
if [ -z "${LOG_FILE}" ]; then
  LOG_FILE="${runtime_root}/higlass-launcher.log"
fi
mkdir -p "$(dirname -- "${LOG_FILE}")"

uwsgi_pid=""
uwsgi_pgid=""
nginx_pid=""
nginx_pgid=""
setup_pid=""
setup_pgid=""
cleanup_done=0

show_logs() {
  echo "higlass: last service log lines:" >&2
  for log_path in \
    "${LOG_FILE}" \
    "${TAFFISH_HIGLASS_DATA_ROOT:-${runtime_root}/data}/log/hgs.log" \
    "${runtime_root}/uwsgi.log" \
    "${runtime_root}/nginx-error.log"; do
    if [ -s "${log_path}" ]; then
      printf >&2 '%s\n' "--- ${log_path}"
      tail -n 80 "${log_path}" >&2 || true
    fi
  done
}

valid_child_pid() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] && [ "$1" -gt 1 ]
}

owned_child_group_alive() {
  local child_pid="$1"
  local child_pgid="$2"
  valid_child_pid "${child_pid}" \
    && valid_child_pid "${child_pgid}" \
    && [ "${child_pid}" -eq "${child_pgid}" ] \
    && kill -0 -- "-${child_pgid}" 2>/dev/null
}

cleanup() {
  if [ "${cleanup_done}" -eq 1 ]; then
    return
  fi
  cleanup_done=1

  local child_pair child_pid child_pgid group_alive attempt
  local -a child_pids=()
  local -a child_pgids=()
  for child_pair in \
    "${setup_pid}:${setup_pgid}" \
    "${nginx_pid}:${nginx_pgid}" \
    "${uwsgi_pid}:${uwsgi_pgid}"; do
    child_pid="${child_pair%%:*}"
    child_pgid="${child_pair#*:}"
    if owned_child_group_alive "${child_pid}" "${child_pgid}"; then
      child_pids+=("${child_pid}")
      child_pgids+=("${child_pgid}")
      kill -TERM -- "-${child_pgid}" 2>/dev/null || true
    fi
  done

  for attempt in $(seq 1 50); do
    group_alive=0
    for child_pgid in "${child_pgids[@]}"; do
      if kill -0 -- "-${child_pgid}" 2>/dev/null; then
        group_alive=1
      fi
    done
    [ "${group_alive}" -eq 0 ] && break
    sleep 0.1
  done

  for child_pgid in "${child_pgids[@]}"; do
    if kill -0 -- "-${child_pgid}" 2>/dev/null; then
      kill -KILL -- "-${child_pgid}" 2>/dev/null || true
    fi
  done
  for child_pid in "${child_pids[@]}"; do
    wait "${child_pid}" 2>/dev/null || true
  done

  rm -rf -- "${runtime_root}"
}

on_signal() {
  local signal_name="$1"
  local signal_status="$2"
  trap - EXIT INT TERM
  printf 'HiGlass is stopping after %s.\n' "${signal_name}"
  cleanup
  echo "HiGlass stopped."
  exit "${signal_status}"
}

trap 'on_signal SIGINT 130' INT
trap 'on_signal SIGTERM 143' TERM
trap 'status=$?; cleanup; exit "${status}"' EXIT

# shellcheck source=/dev/null
source /usr/local/bin/higlass-runtime
taf_higlass_prepare_state "${runtime_root}"

run_setup_step() {
  local step_status
  setsid "$@" >>"${LOG_FILE}" 2>&1 &
  setup_pid="$!"
  setup_pgid="${setup_pid}"
  if wait "${setup_pid}"; then
    step_status=0
  else
    step_status="$?"
  fi
  setup_pid=""
  setup_pgid=""
  return "${step_status}"
}

cat <<EOF
HiGlass is starting.
Host URL: http://127.0.0.1:${HOST_PORT}/app
SSH tunnel: ssh -L ${HOST_PORT}:127.0.0.1:${HOST_PORT} user@server
Stop: press Ctrl-C.
Launcher log: ${LOG_FILE}
Internal logs: ${runtime_root} and ${TAFFISH_HIGLASS_DATA_ROOT}/log
Data mode: ${TAFFISH_HIGLASS_DATA_MODE} (${TAFFISH_HIGLASS_DATA_ROOT})
EOF

if [ -n "${TAFFISH_HIGLASS_TEST_STARTUP_HOLD:-}" ]; then
  run_setup_step sleep "${TAFFISH_HIGLASS_TEST_STARTUP_HOLD}"
fi

cd /home/higlass/projects/higlass-server
run_setup_step python manage.py migrate --noinput
if run_setup_step python manage.py shell -c \
  'from tilesets.models import ViewConf; raise SystemExit(0 if ViewConf.objects.filter(uuid="default").exists() else 1)'; then
  default_view_status=0
else
  default_view_status="$?"
fi
case "${default_view_status}" in
  0) ;;
  1) run_setup_step python manage.py loaddata default-viewconf-fixture.xml ;;
  *)
    printf >&2 'higlass: failed to inspect the default viewconf (status %s).\n' \
      "${default_view_status}"
    show_logs
    exit "${default_view_status}"
    ;;
esac

mkdir -p \
  "${runtime_root}/nginx-client-body" \
  "${runtime_root}/nginx-proxy" \
  "${runtime_root}/nginx-fastcgi" \
  "${runtime_root}/nginx-uwsgi" \
  "${runtime_root}/nginx-scgi"

uwsgi_port=$((PORT + 1))
nginx_config="${runtime_root}/nginx.conf"
cat >"${nginx_config}" <<EOF
worker_processes 1;
pid ${runtime_root}/nginx.pid;
error_log ${runtime_root}/nginx-error.log;

events { worker_connections 768; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65;
  client_body_temp_path ${runtime_root}/nginx-client-body 1 2;
  proxy_temp_path ${runtime_root}/nginx-proxy 1 2;
  fastcgi_temp_path ${runtime_root}/nginx-fastcgi 1 2;
  uwsgi_temp_path ${runtime_root}/nginx-uwsgi 1 2;
  scgi_temp_path ${runtime_root}/nginx-scgi 1 2;
  access_log ${runtime_root}/nginx-access.log;
  gzip on;

  upstream django { server 127.0.0.1:${uwsgi_port}; }

  server {
    listen ${BIND_ADDRESS}:${PORT};
    charset utf-8;
    client_max_body_size 0;

    location /api/v1/ {
      uwsgi_pass django;
      uwsgi_read_timeout 600;
      include /home/higlass/projects/higlass-server/uwsgi_params;
    }
    location /thumbnail/ {
      uwsgi_pass django;
      uwsgi_read_timeout 600;
      include /home/higlass/projects/higlass-server/uwsgi_params;
    }
    location /t/ {
      uwsgi_pass django;
      uwsgi_read_timeout 600;
      include /home/higlass/projects/higlass-server/uwsgi_params;
    }
    location /link/ {
      uwsgi_pass django;
      uwsgi_read_timeout 600;
      include /home/higlass/projects/higlass-server/uwsgi_params;
    }
    location /l/ {
      uwsgi_pass django;
      uwsgi_read_timeout 600;
      include /home/higlass/projects/higlass-server/uwsgi_params;
    }
    location /admin/ {
      uwsgi_pass django;
      uwsgi_read_timeout 600;
      include /home/higlass/projects/higlass-server/uwsgi_params;
    }
    location /hgs-static {
      alias /home/higlass/projects/higlass-server/hgs-static/;
    }
    location /hipiler {
      alias /home/higlass/projects/hipiler/;
      try_files \$uri \$uri/ /index.html =404;
    }
    location / {
      alias /home/higlass/projects/higlass-app/;
      try_files \$uri \$uri/ /index.html =404;
    }
  }
}
EOF

nginx -t -c "${nginx_config}" -p "${runtime_root}" >>"${LOG_FILE}" 2>&1

setsid uwsgi \
  --chdir /home/higlass/projects/higlass-server \
  --socket "127.0.0.1:${uwsgi_port}" \
  --module higlass_server.wsgi \
  --master \
  --workers "${WORKERS}" \
  --die-on-term \
  --need-app \
  --vacuum >"${runtime_root}/uwsgi.log" 2>&1 &
uwsgi_pid="$!"
uwsgi_pgid="${uwsgi_pid}"

setsid nginx -c "${nginx_config}" -p "${runtime_root}" -g 'daemon off;' \
  >"${runtime_root}/nginx-stdout.log" 2>&1 &
nginx_pid="$!"
nginx_pgid="${nginx_pid}"

critical_child_alive() {
  local component="$1"
  local child_pid="$2"
  if ! valid_child_pid "${child_pid}" || ! kill -0 "${child_pid}" 2>/dev/null; then
    printf >&2 'higlass: critical component exited: %s\n' "${component}"
    show_logs
    return 1
  fi
}

ready=0
for ((attempt = 0; attempt < STARTUP_TIMEOUT; attempt += 1)); do
  critical_child_alive uwsgi "${uwsgi_pid}" || exit 1
  critical_child_alive nginx "${nginx_pid}" || exit 1

  if curl -fsS "http://127.0.0.1:${PORT}/api/v1/tilesets/" 2>/dev/null | grep -F '"count"' >/dev/null \
     && curl -fsS "http://127.0.0.1:${PORT}/api/v1/viewconfs/?d=default" 2>/dev/null | grep -F '"views"' >/dev/null \
     && curl -fsS "http://127.0.0.1:${PORT}/app" 2>/dev/null | grep -F 'TAFFISH HiGlass' >/dev/null; then
    ready=1
    break
  fi
  sleep 1
done

if [ "${ready}" -ne 1 ]; then
  printf >&2 'higlass: service was not ready after %s seconds.\n' "${STARTUP_TIMEOUT}"
  show_logs
  exit 1
fi

cat <<EOF
HiGlass is ready.
Open http://127.0.0.1:${HOST_PORT}/app in your browser.
Data mode: ${TAFFISH_HIGLASS_DATA_MODE}.
Press Ctrl-C to stop the HiGlass session.
EOF

case "${TAFFISH_HIGLASS_TEST_KILL_COMPONENT:-}" in
  nginx) kill -KILL "${nginx_pid}" ;;
  uwsgi) kill -KILL "${uwsgi_pid}" ;;
  "") ;;
  *)
    printf >&2 'higlass: invalid internal test component: %s\n' "${TAFFISH_HIGLASS_TEST_KILL_COMPONENT}"
    exit 2
    ;;
esac

while :; do
  critical_child_alive uwsgi "${uwsgi_pid}" || exit 1
  critical_child_alive nginx "${nginx_pid}" || exit 1
  sleep 1
done
