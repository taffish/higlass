#!/usr/bin/env bash
set -euo pipefail

runtime_root="$(mktemp -d /tmp/taf-higlass-manage.XXXXXX)"
cleanup() {
  rm -rf -- "${runtime_root}"
}
trap cleanup EXIT

# shellcheck source=/dev/null
source /usr/local/bin/higlass-runtime
taf_higlass_prepare_state "${runtime_root}"

command_name="${1:-help}"
case "${command_name}" in
  help|--help|-h|version|--version|check)
    ;;
  *)
    if [ "${TAFFISH_HIGLASS_DATA_MODE}" != "persistent" ]; then
      cat >&2 <<'EOF'
higlass-manage: this command may modify the HiGlass database or media store,
but /data is not a real writable bind mount.

Set TAFFISH_HIGLASS_DATA_PATH to a writable host directory and rerun the
installed wrapper. Read-only commands such as help, version, and check work
without persistent storage.
EOF
      exit 64
    fi
    ;;
esac

cd /home/higlass/projects/higlass-server
exec python manage.py "$@"
