<shell>
taf_higlass_data="${TAFFISH_HIGLASS_DATA_PATH:-}"
if test -n "$taf_higlass_data"; then
    if test "$(printf '%s' "$taf_higlass_data" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" != "$taf_higlass_data"; then
        printf >&2 'taf-higlass: data path contains unsupported whitespace, comma, colon, or glob characters: %s\n' "$taf_higlass_data"
        exit 64
    fi
    if ! test -d "$taf_higlass_data" || ! test -w "$taf_higlass_data"; then
        printf >&2 'taf-higlass: TAFFISH_HIGLASS_DATA_PATH is not a writable directory: %s\n' "$taf_higlass_data"
        exit 64
    fi
    taf_higlass_data="$(CDPATH= cd "$taf_higlass_data" 2>/dev/null && pwd -P)"
    if test -z "$taf_higlass_data" || test "$(printf '%s' "$taf_higlass_data" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" != "$taf_higlass_data"; then
        printf >&2 'taf-higlass: data path cannot be represented safely by all supported backends\n'
        exit 64
    fi
fi

<taf-app:container:ghcr.io/taffish/higlass:2.3.5-r2$@[docker: --init --platform linux/amd64 --user=$(id -u):$(id -g) --env=HIGLASS_PORT=8000 --env=HIGLASS_BIND_ADDRESS=0.0.0.0][podman: --platform linux/amd64 --userns=keep-id --user=$(id -u):$(id -g) --env=HIGLASS_PORT=8000 --env=HIGLASS_BIND_ADDRESS=0.0.0.0][docker/podman: $(if test -n "${taf_higlass_data:-}"; then printf -- '--volume=%s:/data' "$taf_higlass_data"; fi)][apptainer: --env=HIGLASS_PORT=8888 --env=HIGLASS_BIND_ADDRESS=127.0.0.1 $(if test -n "${taf_higlass_data:-}"; then printf -- '--bind=%s:/data' "$taf_higlass_data"; fi)]>
higlass ::*ARGV*::
